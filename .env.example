# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_NAME=Content Studio
# Recommended even locally. Required in production unless Google OAuth is enabled; at least 12 characters.
APP_PASSWORD=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional: Google OAuth via Supabase Auth (can be used alongside APP_PASSWORD).
# Copy Project URL and Publishable/anon key from Supabase Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional comma-separated Google email allowlist (leave blank to allow any verified Google account).
ALLOWED_EMAILS=

AI_PROVIDER=openai

# Gemini via Google AI Studio (set AI_PROVIDER=gemini to use these values).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
# Leave blank for OpenAI. For a compatible provider, use its API base including
# /v1 (or its documented prefix), NOT the full /chat/completions endpoint.
OPENAI_BASE_URL=
# auto: OpenAI -> responses; other base URLs -> chat_completions.
# Override with responses or chat_completions when needed.
OPENAI_API_MODE=auto
# json_schema (recommended), json_object, or text (JSON via prompt + validation).
OPENAI_RESPONSE_FORMAT=json_schema
# Chat Completions only; some models require max_completion_tokens instead.
OPENAI_CHAT_TOKEN_PARAMETER=max_tokens
# Use the exact model ID supplied by your provider.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=120

# Groq (set AI_PROVIDER=groq to use these values).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Percent-encode special characters in the DATABASE PASSWORD.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Local-only fallback when DATABASE_URL is empty: ./data/local.db (SQLite).
DATABASE_URL=

# Exact public origin, without trailing slash. Set this on Render/custom domains.
APP_ORIGIN=
# Per process: keep one worker on the initial Render service.
GENERATE_REQUESTS_PER_HOUR=30
MAX_CONCURRENT_GENERATIONS=2

# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_NAME=Content Studio
# Recommended even locally. Required in production; at least 12 characters.
APP_PASSWORD=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

OPENAI_API_KEY=
# Must support the Responses API and Structured Outputs.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=120

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Percent-encode special characters in the DATABASE PASSWORD.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Local-only fallback when DATABASE_URL is empty: ./data/local.db (SQLite).
DATABASE_URL=

# Exact public origin, without trailing slash. Set this on Render/custom domains.
APP_ORIGIN=
# Per process: keep one worker on the initial Render service.
GENERATE_REQUESTS_PER_HOUR=30
MAX_CONCURRENT_GENERATIONS=2
